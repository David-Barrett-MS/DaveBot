{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
    }
  },
  "DaveBot": {
    "EarMtlsPort": 8443,
    "FoundryLocal": {
      "StartupTimeoutSeconds": 180
    },
    "SpeechTranscription": {
      "Model": "nemotron-speech-streaming-en-0.6b",
      "TimeoutSeconds": 20,
      "MaximumRequestBytes": 1000000,
      "MaximumDurationSeconds": 30,
      "QueueCapacity": 2,
      "QueueWaitTimeoutSeconds": 25
    }
  },
  "AllowedHosts": "*"
}
