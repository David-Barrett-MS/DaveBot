{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "DaveBot": {
    "EarMtlsPort": 8443,
    "FoundryLocal": {
      "Executable": "foundry",
      "StartupTimeoutSeconds": 180
    },
    "SpeechTranscription": {
      "Endpoint": "http://127.0.0.1:5273/v1/audio/transcriptions",
      "Model": "whisper-tiny",
      "TimeoutSeconds": 20,
      "MaximumRequestBytes": 1000000,
      "MaximumDurationSeconds": 30,
      "QueueCapacity": 2,
      "QueueWaitTimeoutSeconds": 25
    }
  },
  "AllowedHosts": "*"
}
