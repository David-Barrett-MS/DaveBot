@page
@model DaveBrain.Pages.Automation.IndexModel
@{
    ViewData["Title"] = "Automation";
}

<h1>Automation</h1>
<p>
    Automation is deterministic. The only supported action is
    <code>device.setState</code>; scripts, shell commands, URLs, and expressions
    are not accepted.
</p>
<div class="d-flex gap-2">
    <a class="btn btn-primary" asp-page="/Automation/Actions">Actions</a>
    <a class="btn btn-primary" asp-page="/Automation/Triggers">Triggers</a>
</div>
