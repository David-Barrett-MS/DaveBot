@page
@model DaveBrain.Pages.System.DebugModel
@{
    ViewData["Title"] = "Debug";
}

<h1>Debug</h1>
<p>Browser session entries are retained only for this session and credentials are redacted.</p>
<style>
    .debug-log {
        table-layout: fixed;
        width: 100%;
    }

    .debug-log pre {
        white-space: pre-wrap;
        overflow-wrap: anywhere;
        word-break: break-word;
    }
</style>
<div class="d-flex gap-2 mb-3">
    <button class="btn btn-outline-secondary" id="copy-debug-log" type="button">Copy to clipboard</button>
    <form method="post" asp-page-handler="Clear">
        <button class="btn btn-outline-danger" type="submit">Clear session log</button>
    </form>
</div>
<p class="visually-hidden" id="copy-debug-log-status" aria-live="polite"></p>
<h2>DaveEar activity</h2>
<p>Ear events are shared across administrator sessions and retained while DaveBrain is running.</p>
@if (Model.EarActivities.Count == 0)
{
    <p>No DaveEar activity has been recorded.</p>
}
else
{
    <div class="table-responsive">
    <table class="table debug-log">
        <thead><tr><th>Time (UTC)</th><th>Event</th><th>Ear</th><th>Details</th></tr></thead>
        <tbody>
        @foreach (var entry in Model.EarActivities)
        {
            <tr>
                <td>@entry.OccurredUtc.UtcDateTime.ToString("u")</td>
                <td>@entry.Event</td>
                <td>@entry.EarName<br /><small>@entry.EarId</small></td>
                <td><pre class="mb-0">@entry.Details</pre></td>
            </tr>
        }
        </tbody>
    </table>
    </div>
}
<h2>Browser session activity</h2>
@if (Model.Entries.Count == 0)
{
    <p>No actions have been recorded in this browser session.</p>
}
else
{
    <div class="table-responsive">
    <table class="table debug-log" id="debug-log">
        <thead><tr><th>Time (UTC)</th><th>Category</th><th>Request</th><th>Response</th></tr></thead>
        <tbody>
        @foreach (var entry in Model.Entries)
        {
            <tr>
                <td>@entry.OccurredUtc.UtcDateTime.ToString("u")</td>
                <td>@entry.Category</td>
                <td><pre class="mb-0">@entry.Request</pre></td>
                <td><pre class="mb-0">@entry.Response</pre></td>
            </tr>
        }
        </tbody>
    </table>
    </div>
}

<script>
    (() => {
        const copyButton = document.getElementById("copy-debug-log");
        const status = document.getElementById("copy-debug-log-status");

        copyButton.addEventListener("click", async () => {
            const log = document.getElementById("debug-log");
            const text = log ? log.innerText : "No actions have been recorded in this browser session.";

            try {
                await navigator.clipboard.writeText(text);
                status.textContent = "Debug log copied to clipboard.";
            } catch {
                status.textContent = "Unable to copy the debug log to the clipboard.";
            }
        });
    })();
</script>
