@page
@model DaveBrain.Pages.Devices.IndexModel
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@{
    ViewData["Title"] = Model.IsLightsPage ? "Lights" : "Devices";
    var liveViewRequestToken = Antiforgery.GetAndStoreTokens(HttpContext).RequestToken;
}

<h1>@ViewData["Title"]</h1>
<div id="device-update-status" role="status" aria-live="polite">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    @if (Model.Result is not null)
    {
        <p><strong>@Model.Result.Status</strong>@(Model.Result.Detail is null ? string.Empty : $": {Model.Result.Detail}")</p>
    }
</div>

@if (Model.Devices.Count == 0)
{
    <p>No devices are mapped.</p>
}
else
{
    <table class="table align-middle">
        <thead>
            <tr>
                <th scope="col">Enabled</th>
                <th scope="col">Name</th>
                <th scope="col">
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button"
                                data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                            Type
                        </button>
                        <div class="dropdown-menu p-2 location-filter-menu">
                            <label class="dropdown-item-text d-block mb-2">
                                <input class="form-check-input me-1 filter-select-all" type="checkbox"
                                       data-filter-group="type" checked="@Model.AreAllDeviceTypesSelected()" />
                                <span data-filter-select-label="type">
                                    @(Model.AreAllDeviceTypesSelected() ? "Deselect all" : "Select all")
                                </span>
                            </label>
                            @foreach (var type in Model.DeviceTypes)
                            {
                                <label class="dropdown-item-text d-block">
                                    <input class="form-check-input me-1 device-filter-checkbox" type="checkbox"
                                           data-filter-group="type" data-filter-value="@type"
                                           checked="@Model.IsTypeFilterSelected(type)" />
                                    @type
                                </label>
                            }
                        </div>
                    </div>
                </th>
                <th scope="col">
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-secondary dropdown-toggle" type="button"
                                data-bs-toggle="dropdown" data-bs-auto-close="outside" aria-expanded="false">
                            Location
                        </button>
                        <div class="dropdown-menu p-2 location-filter-menu">
                            <label class="dropdown-item-text d-block mb-2">
                                <input class="form-check-input me-1 filter-select-all" type="checkbox"
                                       data-filter-group="location" checked="@Model.AreAllLocationsSelected()" />
                                <span data-filter-select-label="location">
                                    @(Model.AreAllLocationsSelected() ? "Deselect all" : "Select all")
                                </span>
                            </label>
                            <label class="dropdown-item-text d-block">
                                <input class="form-check-input me-1 device-filter-checkbox" type="checkbox"
                                       data-filter-group="location" data-filter-value="unassigned"
                                       checked="@Model.IsLocationFilterSelected("unassigned")" />
                                No location
                            </label>
                            @foreach (var location in Model.Locations)
                            {
                                <label class="dropdown-item-text d-block">
                                    <input class="form-check-input me-1 device-filter-checkbox" type="checkbox"
                                           data-filter-group="location" data-filter-value="@location.Id"
                                           checked="@Model.IsLocationFilterSelected(location.Id.ToString())" />
                                    @location.Name
                                </label>
                            }
                        </div>
                    </div>
                </th>
                <th scope="col">Groups</th>
                <th scope="col">Cached state</th>
                <th scope="col">Action</th>
            </tr>
        </thead>
        <tbody id="device-results">
        @foreach (var device in Model.Devices)
        {
            var locationFilter = device.LocationId?.ToString() ?? "unassigned";
            var isHueLight = device.DeviceType == "hue.light";
            var isBlinkCamera = device.DeviceType == "blink.camera";
            <tr class="device-row" data-device-id="@device.Id"
                data-location-filter="@locationFilter" data-type-filter="@device.DeviceType">
                <td>
                    <form method="post" asp-page-handler="SetEnabled" data-async-device-update
                          data-async-focus-selector="input[name='enabled'][type='checkbox']">
                        <input type="hidden" name="deviceId" value="@device.Id" />
                        @if (device.Enabled)
                        {
                            <input class="form-check-input" type="checkbox" name="enabled" value="true" checked
                                   aria-label="Enable @device.Name" onchange="this.form.requestSubmit()" />
                        }
                        else
                        {
                            <input class="form-check-input" type="checkbox" name="enabled" value="true"
                                   aria-label="Enable @device.Name" onchange="this.form.requestSubmit()" />
                        }
                        <input type="hidden" name="enabled" value="false" />
                    </form>
                </td>
                <td>@device.Name</td>
                <td><code>@device.DeviceType</code></td>
                <td>
                    <form method="post" asp-page-handler="UpdateLocation" data-async-device-update
                          data-async-focus-selector="select[name='locationId']">
                        <input type="hidden" name="deviceId" value="@device.Id" />
                        <select name="locationId" aria-label="Location for @device.Name" onchange="this.form.requestSubmit()">
                            @if (device.LocationId is null)
                            {
                                <option value="" selected>No location</option>
                            }
                            else
                            {
                                <option value="">No location</option>
                            }
                            @foreach (var location in Model.Locations)
                            {
                                @if (device.LocationId == location.Id)
                                {
                                    <option value="@location.Id" selected>@location.Name</option>
                                }
                                else
                                {
                                    <option value="@location.Id">@location.Name</option>
                                }
                            }
                        </select>
                    </form>
                </td>
                <td>
                    <form method="post" asp-page-handler="UpdateGroups"
                              class="group-membership-form" data-async-device-update
                              data-async-focus-selector=".group-membership-toggle"
                              data-group-membership-changed="false">
                            <input type="hidden" name="deviceId" value="@device.Id" />
                            @if (Model.Groups.Count == 0)
                            {
                                <span class="text-muted">No groups</span>
                            }
                            else
                            {
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-outline-secondary dropdown-toggle group-membership-toggle" type="button"
                                            data-bs-toggle="dropdown" data-bs-auto-close="outside"
                                            aria-expanded="false" aria-label="Groups for @device.Name">
                                        Groups (@(device.GroupIds?.Count ?? 0))
                                    </button>
                                    <div class="dropdown-menu p-2">
                                    @foreach (var group in Model.Groups)
                                    {
                                        <label class="dropdown-item-text d-block">
                                            <input class="form-check-input me-1 group-membership-checkbox"
                                                   type="checkbox" name="groupIds" value="@group.Id"
                                                   checked="@(device.GroupIds?.Contains(group.Id) == true)" />
                                            @group.Name
                                        </label>
                                    }
                                    </div>
                                </div>
                            }
                    </form>
                </td>
                <td>
                    @Model.FormatState(device)
                    @if (Model.GetCachedColourHex(device) is { } colourHex)
                    {
                        <span class="colour-swatch ms-1" style="background-color: @colourHex"
                              title="Cached colour @colourHex" role="img"
                              aria-label="Cached colour @colourHex"></span>
                    }
                </td>
                <td>
                    <div class="d-flex flex-wrap gap-1">
                        @if (isHueLight && device.Capabilities.HasFlag(DaveHome.DeviceCapabilities.OnOff))
                        {
                            <form method="post" data-async-device-update
                                  data-async-focus-selector="button[type='submit']">
                                <input type="hidden" name="deviceId" value="@device.Id" />
                                <input type="hidden" name="action" value="on" />
                                <button type="submit" class="btn btn-sm btn-success" title="Turn on"
                                        aria-label="Turn on @device.Name" disabled="@(!device.Enabled)">
                                    <span aria-hidden="true">&#x25B6;</span> On
                                </button>
                            </form>
                            <form method="post" data-async-device-update
                                  data-async-focus-selector="button[type='submit']">
                                <input type="hidden" name="deviceId" value="@device.Id" />
                                <input type="hidden" name="action" value="off" />
                                <button type="submit" class="btn btn-sm btn-secondary" title="Turn off"
                                        aria-label="Turn off @device.Name" disabled="@(!device.Enabled)">
                                    <span aria-hidden="true">&#x25A0;</span> Off
                                </button>
                            </form>
                        }
                        @if (isHueLight &&
                            (device.Capabilities.HasFlag(DaveHome.DeviceCapabilities.Colour) ||
                             device.Capabilities.HasFlag(DaveHome.DeviceCapabilities.Brightness)))
                        {
                            <button type="button" class="btn btn-sm btn-outline-primary" title="Set colour or brightness"
                                    aria-label="Set colour or brightness for @device.Name" data-bs-toggle="modal"
                                    data-bs-target="#colour-modal-@device.Id" disabled="@(!device.Enabled)">
                                <span aria-hidden="true">&#x25C9;</span> Colour
                            </button>
                        }
                        @if (Model.CanRead(device))
                        {
                            <form method="post" data-async-device-update
                                  data-async-focus-selector="button[type='submit']">
                                <input type="hidden" name="deviceId" value="@device.Id" />
                                <input type="hidden" name="action" value="read" />
                                <button type="submit" class="btn btn-sm btn-outline-secondary" title="Read current state"
                                        aria-label="Read current state for @device.Name" disabled="@(!device.Enabled)">
                                    <span aria-hidden="true">&#x21BB;</span> Read
                                </button>
                            </form>
                        }
                        @if (isBlinkCamera)
                        {
                            <form method="post">
                                <input type="hidden" name="deviceId" value="@device.Id" />
                                <input type="hidden" name="action" value="snapshot" />
                                <button type="submit" class="btn btn-sm btn-outline-primary" title="Get a new snapshot"
                                        aria-label="Get snapshot from @device.Name" disabled="@(!device.Enabled)">
                                    <span aria-hidden="true">&#x1F4F7;</span> Get snapshot
                                </button>
                            </form>
                            <button type="button" class="btn btn-sm btn-outline-danger blink-live-view-button"
                                    title="Open live view" aria-label="Open live view from @device.Name"
                                    data-device-id="@device.Id" data-device-name="@device.Name"
                                    disabled="@(!device.Enabled)">
                                <span aria-hidden="true">&#x25B6;</span> Live view
                            </button>
                        }
                        <button type="button" class="btn btn-sm btn-outline-secondary" title="Other actions"
                                aria-label="Other actions for @device.Name" data-bs-toggle="modal"
                                data-bs-target="#other-modal-@device.Id">
                            <span aria-hidden="true">&#x22EF;</span> Other
                        </button>
                    </div>
                </td>
            </tr>
        }
        </tbody>
    </table>

    @if (Model.Snapshot is { } snapshot)
    {
        var imageDataUri = $"data:{snapshot.ContentType};base64,{Convert.ToBase64String(snapshot.Content)}";
        <div class="modal fade" id="snapshot-modal" tabindex="-1"
             aria-labelledby="snapshot-modal-label" aria-hidden="true">
            <div class="modal-dialog modal-xl modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title fs-5" id="snapshot-modal-label">Snapshot: @Model.SnapshotDeviceName</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body text-center">
                        <img src="@imageDataUri" class="img-fluid" alt="Snapshot from @Model.SnapshotDeviceName" />
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="modal fade" id="live-view-modal" tabindex="-1"
         aria-labelledby="live-view-modal-label" aria-hidden="true"
         data-antiforgery-token="@liveViewRequestToken">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h2 class="modal-title fs-5" id="live-view-modal-label">Live view</h2>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body text-center">
                    <video id="live-view-video" class="w-100 bg-dark" autoplay playsinline muted controls
                           aria-describedby="live-view-status"></video>
                    <p id="live-view-status" class="mt-3 mb-0" role="status">Select a camera to start live view.</p>
                </div>
            </div>
        </div>
    </div>

    <div id="device-action-modals">
    @foreach (var device in Model.Devices)
    {
        var picker = Model.GetColourPickerValue(device.State);
        var isHueLight = device.DeviceType == "hue.light";
        <div class="modal fade" id="other-modal-@device.Id" tabindex="-1" aria-labelledby="other-modal-label-@device.Id" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header">
                        <h2 class="modal-title fs-5" id="other-modal-label-@device.Id">Other actions: @device.Name</h2>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>
                    <div class="modal-body">
                        @if (device.Capabilities.HasFlag(DaveHome.DeviceCapabilities.FanSpeed))
                        {
                            var fanSpeed = Model.GetFanSpeed(device.State);
                            <form method="post" class="mb-3" data-async-device-update>
                                <input type="hidden" name="deviceId" value="@device.Id" />
                                <input type="hidden" name="action" value="set-fan-speed" />
                                <label class="form-label" for="fan-speed-@device.Id">Fan speed</label>
                                <div class="input-group">
                                    <select id="fan-speed-@device.Id" class="form-select" name="fanSpeed">
                                        @for (var speed = 1; speed <= 10; speed++)
                                        {
                                            @if (fanSpeed == speed) { <option value="@speed" selected>@speed</option> } else { <option value="@speed">@speed</option> }
                                        }
                                        @if (fanSpeed == 81) { <option value="81" selected>11</option> } else { <option value="81">11</option> }
                                        @if (fanSpeed == 82) { <option value="82" selected>12</option> } else { <option value="82">12</option> }
                                    </select>
                                    <button type="submit" class="btn btn-primary" disabled="@(!device.Enabled)">Set</button>
                                </div>
                            </form>
                        }
                        <form method="post">
                            <input type="hidden" name="deviceId" value="@device.Id" />
                            <input type="hidden" name="action" value="remove" />
                            <button type="submit" class="btn btn-outline-danger">Remove mapping</button>
                        </form>
                    </div>
                </div>
            </div>
        </div>

        @if (isHueLight &&
            (device.Capabilities.HasFlag(DaveHome.DeviceCapabilities.Colour) ||
             device.Capabilities.HasFlag(DaveHome.DeviceCapabilities.Brightness)))
        {
            <div class="modal fade" id="colour-modal-@device.Id" tabindex="-1" aria-labelledby="colour-modal-label-@device.Id" aria-hidden="true">
                <div class="modal-dialog">
                    <div class="modal-content">
                        <form method="post" data-async-device-update>
                            <div class="modal-header">
                                <h2 class="modal-title fs-5" id="colour-modal-label-@device.Id">Colour / brightness: @device.Name</h2>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <div class="modal-body">
                                <input type="hidden" name="deviceId" value="@device.Id" />
                                <input type="hidden" name="action" value="set-colour-brightness" />
                                <p class="text-muted">Select one or both values to update.</p>
                                @if (device.Capabilities.HasFlag(DaveHome.DeviceCapabilities.Colour))
                                {
                                    <div class="form-check mb-2">
                                        <input id="update-colour-@device.Id" class="form-check-input colour-update-toggle"
                                               type="checkbox" name="updateColour" value="true"
                                               data-control-target="colour-control-@device.Id" />
                                        <input type="hidden" name="updateColour" value="false" />
                                        <label class="form-check-label" for="update-colour-@device.Id">Update colour</label>
                                    </div>
                                    <fieldset id="colour-control-@device.Id" disabled>
                                        <input id="colour-x-@device.Id" type="hidden" name="colourX" value="@picker.X" />
                                        <input id="colour-y-@device.Id" type="hidden" name="colourY" value="@picker.Y" />
                                        <label class="form-label" for="colour-picker-@device.Id">Colour</label>
                                        <input id="colour-picker-@device.Id" class="form-control form-control-color rgb-colour-picker"
                                               type="color" value="@picker.Hex" data-colour-x-target="colour-x-@device.Id"
                                               data-colour-y-target="colour-y-@device.Id" />
                                    </fieldset>
                                }
                                @if (device.Capabilities.HasFlag(DaveHome.DeviceCapabilities.Brightness))
                                {
                                    <div class="form-check mt-3 mb-2">
                                        <input id="update-brightness-@device.Id" class="form-check-input colour-update-toggle"
                                               type="checkbox" name="updateBrightness" value="true"
                                               data-control-target="brightness-control-@device.Id" />
                                        <input type="hidden" name="updateBrightness" value="false" />
                                        <label class="form-check-label" for="update-brightness-@device.Id">Update brightness</label>
                                    </div>
                                    <fieldset id="brightness-control-@device.Id" disabled>
                                        <label class="form-label" for="colour-brightness-@device.Id">Brightness: <output id="colour-brightness-output-@device.Id">@picker.Brightness</output>%</label>
                                        <input id="colour-brightness-@device.Id" class="form-range brightness-picker" type="range"
                                               name="brightness" min="0" max="100" value="@picker.Brightness"
                                               data-brightness-output-target="colour-brightness-output-@device.Id" />
                                    </fieldset>
                                }
                            </div>
                            <div class="modal-footer">
                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                                <button type="submit" class="btn btn-primary">Apply</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        }
    }
    </div>
}

@section Scripts {
    <script>
        (() => {
            const snapshotModal = document.getElementById("snapshot-modal");
            if (snapshotModal) {
                bootstrap.Modal.getOrCreateInstance(snapshotModal).show();
            }

            const liveViewModal = document.getElementById("live-view-modal");
            const liveViewVideo = document.getElementById("live-view-video");
            const liveViewStatus = document.getElementById("live-view-status");
            const liveViewTitle = document.getElementById("live-view-modal-label");
            const liveViewRequestToken = liveViewModal?.dataset.antiforgeryToken;
            let activeLiveView = null;
            let liveViewStartController = null;

            const liveViewErrorMessage = code => ({
                "unsupported-browser": "This browser cannot receive the live stream.",
                "blink-authorization-failed": "Blink authorization is no longer valid.",
                "camera-not-found": "This camera is no longer available.",
                "live-view-timeout": "Live view setup timed out.",
                "invalid-request": "The live view request was invalid."
            }[code] ?? "Live view is unavailable. Please try again.");

            const setLiveViewStatus = message => {
                liveViewStatus.textContent = message;
            };

            const waitForIceGathering = peerConnection => {
                if (peerConnection.iceGatheringState === "complete") {
                    return Promise.resolve();
                }

                return new Promise(resolve => {
                    const timeout = window.setTimeout(done, 5000);
                    function done() {
                        window.clearTimeout(timeout);
                        peerConnection.removeEventListener("icegatheringstatechange", gathered);
                        resolve();
                    }
                    function gathered() {
                        if (peerConnection.iceGatheringState === "complete") {
                            done();
                        }
                    }
                    peerConnection.addEventListener("icegatheringstatechange", gathered);
                });
            };

            const stopLiveView = async (statusMessage = null, reason = "modal-closed") => {
                liveViewStartController?.abort();
                liveViewStartController = null;
                const active = activeLiveView;
                activeLiveView = null;
                if (active) {
                    active.peerConnection.close();
                    liveViewVideo.srcObject = null;
                    try {
                        await fetch("/api/v1/blink/live-view/stop", {
                            method: "POST",
                            credentials: "same-origin",
                            keepalive: true,
                            headers: {
                                "Content-Type": "application/json",
                                "RequestVerificationToken": liveViewRequestToken
                            },
                            body: JSON.stringify({ sessionId: active.sessionId, reason })
                        });
                    } catch {
                    }
                }

                if (statusMessage) {
                    setLiveViewStatus(statusMessage);
                }
            };

            const startLiveView = async button => {
                await stopLiveView(null, "replaced");
                liveViewTitle.textContent = `Live view: ${button.dataset.deviceName}`;
                liveViewVideo.srcObject = null;
                setLiveViewStatus("Preparing live view…");
                bootstrap.Modal.getOrCreateInstance(liveViewModal).show();

                const peerConnection = new RTCPeerConnection({ iceServers: [] });
                peerConnection.addTransceiver("video", { direction: "recvonly" });
                peerConnection.addEventListener("track", event => {
                    liveViewVideo.srcObject = event.streams[0];
                    void liveViewVideo.play().catch(() => {
                        setLiveViewStatus("Live view is ready. Use the video controls to play it.");
                    });
                });
                peerConnection.addEventListener("connectionstatechange", () => {
                    if (activeLiveView?.peerConnection !== peerConnection) {
                        return;
                    }

                    if (peerConnection.connectionState === "connected") {
                        setLiveViewStatus("Live view is connected.");
                    } else if (peerConnection.connectionState === "disconnected") {
                        setLiveViewStatus("Live view connection interrupted; waiting to reconnect.");
                    } else if (["failed", "closed"].includes(peerConnection.connectionState)) {
                        void stopLiveView("Live view ended.", "peer-failed");
                    }
                });

                liveViewStartController = new AbortController();
                try {
                    const offer = await peerConnection.createOffer();
                    await peerConnection.setLocalDescription(offer);
                    await waitForIceGathering(peerConnection);
                    const response = await fetch("/api/v1/blink/live-view", {
                        method: "POST",
                        credentials: "same-origin",
                        signal: liveViewStartController.signal,
                        headers: {
                            "Content-Type": "application/json",
                            "RequestVerificationToken": liveViewRequestToken
                        },
                        body: JSON.stringify({
                            deviceId: button.dataset.deviceId,
                            sdp: peerConnection.localDescription.sdp
                        })
                    });
                    const result = await response.json().catch(() => ({}));
                    if (!response.ok || !result.sessionId || !result.sdp || result.type !== "answer") {
                        throw new Error(result.error || "live-view-unavailable");
                    }

                    activeLiveView = { peerConnection, sessionId: result.sessionId };
                    liveViewStartController = null;
                    await peerConnection.setRemoteDescription({ type: result.type, sdp: result.sdp });
                    setLiveViewStatus("Connecting to camera…");
                } catch (error) {
                    if (error.name !== "AbortError") {
                        setLiveViewStatus(liveViewErrorMessage(error.message));
                    }
                    if (activeLiveView?.peerConnection === peerConnection) {
                        await stopLiveView(null, "start-failed");
                    } else {
                        peerConnection.close();
                    }
                } finally {
                    if (liveViewStartController?.signal.aborted) {
                        liveViewStartController = null;
                    }
                }
            };

            document.addEventListener("click", event => {
                const button = event.target.closest(".blink-live-view-button");
                if (button) {
                    void startLiveView(button);
                }
            });
            liveViewModal?.addEventListener("hidden.bs.modal", () => void stopLiveView(null, "modal-closed"));
            window.addEventListener("pagehide", () => void stopLiveView(null, "page-unload"));

            const filterCheckboxes = group =>
                Array.from(document.querySelectorAll(
                    `.device-filter-checkbox[data-filter-group="${group}"]`));

            const selectedFilterValues = group =>
                filterCheckboxes(group)
                    .filter(filter => filter.checked)
                    .map(filter => filter.dataset.filterValue);

            const updateDeviceFilters = () => {
                const selectedLocations = new Set(selectedFilterValues("location"));
                const selectedTypes = new Set(selectedFilterValues("type"));
                document.querySelectorAll(".device-row").forEach(row => {
                    row.hidden = !selectedLocations.has(row.dataset.locationFilter) ||
                        !selectedTypes.has(row.dataset.typeFilter);
                });
            };

            const syncFiltersToUrl = () => {
                const url = new URL(window.location.href);
                for (const [group, parameter] of [["location", "locationFilter"], ["type", "typeFilter"]]) {
                    const filters = filterCheckboxes(group);
                    const selected = selectedFilterValues(group);
                    if (selected.length === filters.length) {
                        url.searchParams.delete(parameter);
                    } else {
                        url.searchParams.set(parameter, selected.join(","));
                    }
                }
                window.history.replaceState(null, "", url);
            };

            const updateSelectAllCheckboxes = () => {
                document.querySelectorAll(".filter-select-all").forEach(selectAll => {
                    const group = selectAll.dataset.filterGroup;
                    const filters = filterCheckboxes(group);
                    const allSelected = filters.length > 0 && filters.every(filter => filter.checked);
                    selectAll.checked = allSelected;
                    document.querySelector(`[data-filter-select-label="${group}"]`).textContent =
                        allSelected ? "Deselect all" : "Select all";
                });
            };

            const appendFilterToForm = (form, group, parameter) => {
                const filters = filterCheckboxes(group);
                const selected = selectedFilterValues(group);
                const existingFilter = form.querySelector(`input[type="hidden"][name="${parameter}"]`);
                if (selected.length === filters.length) {
                    existingFilter?.remove();
                    return;
                }

                if (existingFilter) {
                    existingFilter.value = selected.join(",");
                    return;
                }

                const filter = document.createElement("input");
                filter.type = "hidden";
                filter.name = parameter;
                filter.value = selected.join(",");
                form.append(filter);
            };

            const submitDeviceUpdate = async form => {
                if (form.dataset.asyncSubmitting === "true") {
                    return;
                }

                const deviceId = form.querySelector("input[name='deviceId']")?.value ??
                    form.closest(".device-row")?.dataset.deviceId;
                const focusSelector = form.dataset.asyncFocusSelector;
                const originatingModal = form.closest(".modal");
                const formData = new FormData(form);
                const controls = form.querySelectorAll("input, select, button");
                form.dataset.asyncSubmitting = "true";
                form.setAttribute("aria-busy", "true");
                controls.forEach(control => {
                    control.disabled = true;
                });

                try {
                    const response = await fetch(form.action, {
                        method: "POST",
                        body: formData,
                        credentials: "same-origin",
                        headers: { "X-Requested-With": "XMLHttpRequest" }
                    });
                    if (!response.ok) {
                        throw new Error(`The server returned HTTP ${response.status}.`);
                    }

                    const documentResponse = new DOMParser()
                        .parseFromString(await response.text(), "text/html");
                    const updatedResults = documentResponse.getElementById("device-results");
                    const updatedStatus = documentResponse.getElementById("device-update-status");
                    const updatedActionModals = documentResponse.getElementById("device-action-modals");
                    const currentResults = document.getElementById("device-results");
                    const currentStatus = document.getElementById("device-update-status");
                    const currentActionModals = document.getElementById("device-action-modals");
                    if (!updatedResults || !updatedStatus || !updatedActionModals ||
                        !currentResults || !currentStatus || !currentActionModals) {
                        throw new Error("The server returned an incomplete device update.");
                    }

                    if (originatingModal) {
                        bootstrap.Modal.getInstance(originatingModal)?.hide();
                    }
                    currentResults.replaceWith(updatedResults);
                    currentStatus.replaceWith(updatedStatus);
                    currentActionModals.replaceWith(updatedActionModals);
                    updateDeviceFilters();

                    const updatedRow = Array.from(document.querySelectorAll(".device-row"))
                        .find(row => row.dataset.deviceId === deviceId);
                    if (focusSelector) {
                        updatedRow?.querySelector(focusSelector)?.focus({ preventScroll: true });
                    }
                } catch {
                    const status = document.getElementById("device-update-status");
                    status.textContent = "The device update could not be completed. Please try again.";
                } finally {
                    if (form.isConnected) {
                        form.removeAttribute("aria-busy");
                        delete form.dataset.asyncSubmitting;
                        controls.forEach(control => {
                            control.disabled = false;
                        });
                    }
                }
            };

            const rgbToXy = colour => {
                const red = parseInt(colour.slice(1, 3), 16) / 255;
                const green = parseInt(colour.slice(3, 5), 16) / 255;
                const blue = parseInt(colour.slice(5, 7), 16) / 255;
                const linear = component => component <= 0.04045
                    ? component / 12.92
                    : Math.pow((component + 0.055) / 1.055, 2.4);
                const r = linear(red);
                const g = linear(green);
                const b = linear(blue);
                const x = r * 0.4124 + g * 0.3576 + b * 0.1805;
                const y = r * 0.2126 + g * 0.7152 + b * 0.0722;
                const z = r * 0.0193 + g * 0.1192 + b * 0.9505;
                const total = x + y + z;
                return total > 0 ? [x / total, y / total] : [0.3127, 0.3290];
            };

            document.addEventListener("change", event => {
                if (event.target.matches(".device-filter-checkbox")) {
                    updateDeviceFilters();
                    updateSelectAllCheckboxes();
                    syncFiltersToUrl();
                }

                if (event.target.matches(".filter-select-all")) {
                    const selected = event.target.checked;
                    filterCheckboxes(event.target.dataset.filterGroup).forEach(filter => {
                        filter.checked = selected;
                    });
                    updateDeviceFilters();
                    updateSelectAllCheckboxes();
                    syncFiltersToUrl();
                }

                if (event.target.matches(".colour-update-toggle")) {
                    document.getElementById(event.target.dataset.controlTarget).disabled = !event.target.checked;
                }

                if (event.target.matches(".group-membership-checkbox")) {
                    event.target.closest(".group-membership-form").dataset.groupMembershipChanged = "true";
                }
            });

            document.addEventListener("hidden.bs.dropdown", event => {
                const form = event.target.closest(".group-membership-form");
                if (form?.dataset.groupMembershipChanged === "true") {
                    form.requestSubmit();
                }
            });

            document.addEventListener("submit", event => {
                if (!event.target.matches("form")) {
                    return;
                }

                appendFilterToForm(event.target, "location", "locationFilter");
                appendFilterToForm(event.target, "type", "typeFilter");

                if (event.target.matches("form[data-async-device-update]")) {
                    event.preventDefault();
                    void submitDeviceUpdate(event.target);
                }
            });

            document.addEventListener("input", event => {
                if (event.target.matches(".rgb-colour-picker")) {
                    const [x, y] = rgbToXy(event.target.value);
                    document.getElementById(event.target.dataset.colourXTarget).value = x.toFixed(6);
                    document.getElementById(event.target.dataset.colourYTarget).value = y.toFixed(6);
                }

                if (event.target.matches(".brightness-picker")) {
                    document.getElementById(event.target.dataset.brightnessOutputTarget).value = event.target.value;
                }
            });

            updateDeviceFilters();
            updateSelectAllCheckboxes();
            syncFiltersToUrl();
        })();
    </script>
}
