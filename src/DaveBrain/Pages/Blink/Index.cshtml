@page
@model DaveBrain.Pages.Blink.IndexModel
@{
    ViewData["Title"] = "Blink Cameras";
}

<h1>Blink Cameras</h1>
<div asp-validation-summary="ModelOnly" class="text-danger"></div>
@if (TempData["StatusMessage"] is string statusMessage)
{
    <p class="alert alert-success">@statusMessage</p>
}

@if (Model.Hubs.Count == 0)
{
    <section>
        <h2>Connect Blink account</h2>
        <p>Connect your Blink account to discover cameras. Your password is used only for this connection and is not stored.</p>
        <form method="post" asp-page-handler="Connect">
            <div class="mb-3">
                <label for="hub-name" class="form-label">Account name</label>
                <input id="hub-name" name="hubName" value="Blink" maxlength="200" class="form-control" required />
            </div>
            <div class="mb-3">
                <label for="account-email" class="form-label">Blink account email</label>
                <input id="account-email" name="email" type="email" maxlength="320" autocomplete="username" class="form-control" required />
            </div>
            <div class="mb-3">
                <label for="account-password" class="form-label">Blink account password</label>
                <input id="account-password" name="password" type="password" maxlength="1000" autocomplete="current-password" class="form-control" required />
            </div>
            <button type="submit" class="btn btn-primary">Connect account</button>
        </form>
    </section>
}

@if (Model.VerificationId is not null)
{
    <section class="mt-4">
        <h2>Verify Blink account</h2>
        <p>Enter the verification code sent by Blink to complete account connection.</p>
        <form method="post" asp-page-handler="CompleteVerification">
            <input type="hidden" name="verificationId" value="@Model.VerificationId" />
            <label for="verification-code" class="form-label">Verification code</label>
            <input id="verification-code" name="code" maxlength="100" autocomplete="one-time-code" class="form-control" required />
            <button type="submit" class="btn btn-primary mt-2">Verify and connect</button>
        </form>
    </section>
}

@if (Model.Hubs.Count > 0)
{
    <section class="mt-4">
        <h2>Linked account</h2>
        @foreach (var hub in Model.Hubs)
        {
            <div class="d-flex gap-2 align-items-center mb-2">
                <strong>@hub.Name</strong>
                <form method="post" asp-page-handler="CheckCameras">
                    <input type="hidden" name="hubId" value="@hub.Id" />
                    <button type="submit" class="btn btn-sm btn-secondary">Check for new cameras</button>
                </form>
                <form method="post" asp-page-handler="Unlink">
                    <input type="hidden" name="hubId" value="@hub.Id" />
                    <button type="submit" class="btn btn-sm btn-danger">Unlink</button>
                </form>
            </div>
        }
    </section>
}

@if (Model.CandidateHubId is not null)
{
    <section class="mt-4">
        <h2>Import Blink cameras</h2>
        @if (Model.Candidates.Count == 0)
        {
            <p>No new Blink cameras were found.</p>
        }
        else
        {
            var index = 0;
            <form method="post" asp-page-handler="ImportSelected">
                <input type="hidden" name="hubId" value="@Model.CandidateHubId" />
                <partial name="_BulkImportToolbar" model='new BulkImportToolbarModel("blink-camera-selection")' />
                <table class="table">
                    <thead><tr><th>Select</th><th>Name</th><th>Model</th><th>Location</th></tr></thead>
                    <tbody>
                    @foreach (var camera in Model.Candidates)
                    {
                        <tr>
                            <td>
                                <input class="blink-camera-selection" type="checkbox"
                                       name="selections[@index].Selected" value="true" aria-label="Select @camera.Name" />
                                <input type="hidden" name="selections[@index].Selected" value="false" />
                            </td>
                            <td>
                                <input type="hidden" name="selections[@index].CameraId" value="@camera.CameraId" />
                                <input name="selections[@index].DisplayName" value="@camera.Name" maxlength="200"
                                       aria-label="Display name for @camera.Name" class="form-control" required />
                            </td>
                            <td>@(camera.Model ?? "Unknown")</td>
                            <td>
                                <select name="selections[@index].LocationId" class="form-select" aria-label="Location for @camera.Name">
                                    <option value="">No location</option>
                                    @foreach (var location in Model.Locations)
                                    {
                                        <option value="@location.Id">@location.Name</option>
                                    }
                                </select>
                            </td>
                        </tr>
                        index++;
                    }
                    </tbody>
                </table>
                <button type="submit" class="btn btn-primary">Import selected</button>
            </form>
        }
    </section>
}

<section class="mt-4">
    <h2>Imported Blink cameras</h2>
    @if (Model.Cameras.Count == 0)
    {
        <p>No Blink cameras are imported.</p>
    }
    else
    {
        <table class="table">
            <thead><tr><th>Name</th><th>Location</th><th>Enabled</th></tr></thead>
            <tbody>
            @foreach (var camera in Model.Cameras)
            {
                <tr>
                    <td>@camera.Name</td>
                    <td>@Model.Locations.SingleOrDefault(location => location.Id == camera.LocationId)?.Name</td>
                    <td>@(camera.Enabled ? "Enabled" : "Disabled")</td>
                </tr>
            }
            </tbody>
        </table>
    }
</section>
