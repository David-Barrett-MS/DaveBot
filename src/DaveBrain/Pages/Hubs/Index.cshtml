@page
@model DaveBrain.Pages.Hubs.IndexModel
@{
    ViewData["Title"] = "Hue bridges";
}

<h1>Hue bridges</h1>
<p>Press the physical link button on the bridge immediately before linking it.</p>
@if (TempData["StatusMessage"] is string statusMessage)
{
    <p class="alert alert-success">@statusMessage</p>
}

<form method="post" asp-page-handler="Discover" class="mb-4">
    <button type="submit" class="btn btn-secondary">Discover local bridges</button>
</form>

@if (Model.Discovered.Count > 0)
{
    <h2>Discovered bridges</h2>
    <ul>
    @foreach (var bridge in Model.Discovered)
    {
        <li>
            @bridge.BridgeId - @bridge.Address
            <form method="post" asp-page-handler="Link" class="d-inline">
                <input type="hidden" name="BridgeName" value="Hue bridge @bridge.BridgeId" />
                <input type="hidden" name="BridgeAddress" value="@bridge.Address" />
                <input type="hidden" name="BridgeId" value="@bridge.BridgeId" />
                <button type="submit" class="btn btn-sm btn-primary">Link</button>
            </form>
        </li>
    }
    </ul>
}

<h2>Link bridge</h2>
<form method="post" asp-page-handler="Link" class="mb-4">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3">
        <label asp-for="BridgeName" class="form-label"></label>
        <input asp-for="BridgeName" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="BridgeAddress" class="form-label"></label>
        <input asp-for="BridgeAddress" class="form-control" placeholder="https://192.168.1.20/" />
    </div>
    <button type="submit" class="btn btn-primary">Link bridge</button>
</form>

@if (Model.Hubs.Count == 0)
{
    <p>No Hue bridges are linked.</p>
}
else
{
    <table class="table">
        <thead><tr><th>Name</th><th>Address</th><th>State</th><th></th></tr></thead>
        <tbody>
        @foreach (var hub in Model.Hubs)
        {
            <tr>
                <td>@hub.Name</td>
                <td>@hub.Address</td>
                <td>@(hub.Enabled ? "Linked" : "Disabled")</td>
                <td>
                    <form method="get" asp-page="/Hubs/Import" class="d-inline">
                        <input type="hidden" name="hubId" value="@hub.Id" />
                        <button type="submit" class="btn btn-sm btn-secondary">Check for new devices</button>
                    </form>
                </td>
            </tr>
        }
        </tbody>
    </table>
}

<section class="mt-5" aria-labelledby="listener-debug-heading">
    <div class="d-flex align-items-center gap-3 mb-2">
        <h2 id="listener-debug-heading" class="mb-0">Hue listener debug</h2>
        <button type="button" class="btn btn-outline-secondary" id="toggle-listener-debug"
                aria-controls="listener-debug-output" aria-pressed="false">
            Enable event display
        </button>
    </div>
    <p id="listener-debug-status">Event display is disabled.</p>
    <pre id="listener-debug-output" class="border rounded p-3 bg-light" hidden aria-live="polite"></pre>
</section>

@section Scripts {
    <script>
        (() => {
            const toggle = document.getElementById("toggle-listener-debug");
            const status = document.getElementById("listener-debug-status");
            const output = document.getElementById("listener-debug-output");
            let enabled = false;
            let latestSequence = 0;
            let timer;
            let requestInFlight = false;

            const formatEvent = event => {
                const received = new Date(event.receivedAt).toLocaleTimeString();
                const attributes = Object.entries(event.attributes ?? {})
                    .map(([key, value]) => `${key}=${value}`)
                    .join(", ");
                return `[${received}] ${event.deviceName}: ${event.eventId || "state update"}${attributes ? ` (${attributes})` : ""}`;
            };

            const readEvents = async () => {
                if (!enabled || requestInFlight) {
                    return;
                }

                requestInFlight = true;
                try {
                    const response = await fetch(`?handler=ListenerEvents&after=${latestSequence}`, {
                        cache: "no-store",
                        credentials: "same-origin"
                    });
                    if (!response.ok) {
                        throw new Error(`HTTP ${response.status}`);
                    }

                    const snapshot = await response.json();
                    for (const event of snapshot.events) {
                        output.textContent += `${formatEvent(event)}\n`;
                    }
                    latestSequence = snapshot.latestSequence;
                    output.scrollTop = output.scrollHeight;
                    if (enabled) {
                        status.textContent = "Displaying events received from mapped Hue devices.";
                    }
                } catch {
                    if (enabled) {
                        status.textContent = "Unable to retrieve listener events. Retrying while event display is enabled.";
                    }
                } finally {
                    requestInFlight = false;
                }
            };

            const setEnabled = value => {
                enabled = value;
                toggle.textContent = enabled ? "Disable event display" : "Enable event display";
                toggle.setAttribute("aria-pressed", enabled.toString());
                output.hidden = !enabled;
                if (enabled) {
                    status.textContent = "Waiting for Hue listener events.";
                    readEvents();
                    timer = window.setInterval(readEvents, 1000);
                } else {
                    window.clearInterval(timer);
                    timer = undefined;
                    status.textContent = "Event display is disabled.";
                }
            };

            toggle.addEventListener("click", () => setEnabled(!enabled));
        })();
    </script>
}
