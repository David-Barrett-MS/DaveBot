@model DaveBrain.Pages.Shared.BulkImportToolbarModel

<div class="d-flex flex-wrap gap-2 mb-3">
    <button type="button" class="btn btn-outline-secondary"
            data-selection-css-class="@Model.SelectionCssClass" data-selected="true">
        Select all
    </button>
    <button type="button" class="btn btn-outline-secondary"
            data-selection-css-class="@Model.SelectionCssClass" data-selected="false">
        Deselect all
    </button>
    <button type="submit" class="btn btn-primary">Import selected</button>
</div>
